depends: [
  "ocaml"
  "dune" {>= "3.15"}
  "core"
  "core_unix"
  "re"
  "angstrom"
  "fpath"
  "fmt"
  "alcotest"
  "bisect_ppx"
  "ppx_string"
  "ppx_deriving"
  "ppx_compare"
  "ppx_variants_conv"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/georgejkaye/postgres-codegen.git"
